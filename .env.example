# -*- coding: utf-8 -*-
# =============================================================================
# Process Name: AI-Windows-Admin (AI-TC) - Environment Secrets Template (.env.example)
# =============================================================================
# Description:
#   Шаблон секретов и переменных окружения для проекта AI-Windows-Admin (ai-tc).
#   Скопируйте данный файл в `.env` и укажите ваши приватные ключи API и токены:
#     copy .env.example .env
#   Публичная конфигурация (порты, модели, эндпоинты) размещается в `config.json`.
#   НИКОГДА не коммитьте реальный файл `.env` в систему контроля версий!
#
# File: .env.example
# Project: ai-windows-admin
# Author: hypo69
# Copyright: © 2026 hypo69
# Updated: 2026-10-31 19:10:00
# =============================================================================

# -----------------------------------------------------------------------------
# Системные пути и идентификатор приложения
# -----------------------------------------------------------------------------
APP_NAME=ai-tc
AITC_DIR=
AIWINDOWSADMIN_DIR=

# -----------------------------------------------------------------------------
# Google Gemini & Google GenAI SDK Configuration
# -----------------------------------------------------------------------------
# Ключи Google Gemini API управляются динамически через пул секретов (src/secrets/gemini_keys.json)
# и автоматически ротируются. Дополнительные ключи пула можно задать через переменные окружения:
# GEMINI_API_KEY_1=your_first_gemini_key
# GEMINI_API_KEY_2=your_second_gemini_key
GEMINI_API_KEY=your_primary_gemini_api_key

# Antigravity (AGY) API Key
AGY_API_KEY=

# -----------------------------------------------------------------------------
# Локальные и облачные AI провайдеры (Foundry, Ollama, OpenAI, HuggingFace)
# -----------------------------------------------------------------------------
# Microsoft AI Foundry API Key (если требуется аутентификация локального сервиса)
FOUNDRY_API_KEY=

# OpenAI API Key (эндпоинты и списки моделей настраиваются в config.json)
OPENAI_API_KEY=your_openai_api_key_here

# HuggingFace Token (для доступа к закрытым моделям или HF Inference API)
HF_TOKEN=your_huggingface_token_here

# -----------------------------------------------------------------------------
# Безопасность, аутентификация и сессии
# -----------------------------------------------------------------------------
# Пароль для доступа к панели администратора /admin
ADMIN_PASSWORD=admin_secure_password_here

# JWT Secret для подписи токенов аутентификации и сессий.
# Сгенерируйте надежный ключ командой:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=your_jwt_secret_key_here

# Режим авторизации (true для включения проверки учетных записей)
DISABLE_AUTH=true

# Google OAuth 2.0 (Опционально)
ENABLE_OAUTH=false
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback

# -----------------------------------------------------------------------------
# Базы данных (MariaDB / Hostinger Knowledge DB & SQLite)
# -----------------------------------------------------------------------------
# Параметры удаленной базы знаний WikiLLM / AI Instruments (Hostinger MariaDB):
MARIADB_HOST=srv1502.hstgr.io
MARIADB_PORT=3306
MARIADB_USER=u177424397_davidka
MARIADB_PASSWORD=your_mariadb_password_here
MARIADB_DATABASE=u177424397_comp_knowledge

# Токен API моста Hostinger (wikillm_hostinger.php)
HOSTINGER_PHP_API_KEY=test_token_123

# -----------------------------------------------------------------------------
# Туннелирование и удаленный доступ
# -----------------------------------------------------------------------------
# Пользовательский домен для внешнего веб-интерфейса (например, kino.davidka.net)
USER_DOMAIN=kino.davidka.net

# Cloudflare Tunnel Token для удаленного ingress
CLOUDFLARE_TUNNEL_TOKEN=

# Ngrok authtoken для проброса локального порта
NGROK_AUTHTOKEN=

# -----------------------------------------------------------------------------
# Уведомления и почтовая инфраструктура (IMAP / SMTP)
# -----------------------------------------------------------------------------
# Все почтовые ящики управляются централизованно через src/secrets/mailboxes.json.
# Параметры SMTP по умолчанию для служебных уведомлений:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Telegram Bot Token для отправки системных алертов
TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# SSL / TLS Сертификаты (HTTPS)
# -----------------------------------------------------------------------------
# Абсолютные пути к файлам сертификата и ключа.
# При пустых значениях используется стандартный путь: ~/.certs/localhost+2.pem
SSL_CERT_FILE=
SSL_KEY_FILE=

# -----------------------------------------------------------------------------
# Дополнительные сервисы
# -----------------------------------------------------------------------------
# Синтез речи (голос Microsoft Edge TTS)
TTS_VOICE=ru-RU-DmitryNeural

# GitHub Token (для обновлений и синхронизации)
GITHUB_TOKEN=
GIT_BRANCH=main
