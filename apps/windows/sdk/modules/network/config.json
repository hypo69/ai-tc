{
  "launcher": "Run-NetworkTerminal.ps1",
  "server": {
    "port": 8101,
    "dedicated": false,
    "use_ssl": false,
    "workers": 1
  },
  "server_cors_origins": [],
  "server_cors_allow_credentials": true,
  "cors": {
    "allow_origins": [],
    "allow_origin_regex": null,
    "allow_credentials": true,
    "allow_methods": [
      "*"
    ],
    "allow_headers": [
      "*"
    ]
  },
  "infra": {
    "ps_timeout_sec": 25,
    "wsl_timeout_sec": 15,
    "cache_ttl_sec": 30,
    "retention_max_snapshots": 200,
    "retention_days": 90,
    "max_workers": 5
  }
}